# PostgreSQL connection string, e.g.
# postgresql://trello:trello@localhost:5432/trello_lite?schema=public
DATABASE_URL="postgresql://trello:trello@localhost:5432/trello_lite?schema=public"

# API
PORT=3001
CORS_ORIGIN="http://localhost:5173"

# Use long random strings (32+ characters) in production.
JWT_ACCESS_SECRET="dev-access-secret-change-me-at-least-32-chars"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-at-least-32-chars"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Refresh cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Rate limit: requests per minute per IP
RATE_LIMIT_MAX=120
